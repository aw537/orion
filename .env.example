# Embedding provider: ollama (default, local, free) | google (better quality)
EMBEDDING_PROVIDER=ollama

# LLM provider: ollama (default, local, free) | anthropic | openai
LLM_PROVIDER=ollama

# Optional: Google Embeddings v2 (requires GCP account)
GOOGLE_API_KEY=

# Optional: API keys if using cloud LLM providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: Set to require bearer token auth on local API
ORION_LOCAL_TOKEN=

# Auth: set to false to require JWT authentication (multi-user / production)
# ORION_AUTH_DISABLED=false

# Database URL
# Local development (default — zero config, SQLite):
# DATABASE_URL=sqlite+aiosqlite:///./data/orion.db
# Cloud / multi-user deployment (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://orion:password@localhost:5432/orion

# PostgreSQL password (used by docker-compose for both postgres service and orion-api)
# POSTGRES_PASSWORD=orion_dev

# Redis URL (default: localhost:6379)
# REDIS_URL=redis://localhost:6379

# ChromaDB URL (default: localhost:8001 for local dev; Docker overrides to http://orion-chroma:8000)
# CHROMA_URL=http://localhost:8001

# Ollama URL (default: localhost:11434)
# OLLAMA_URL=http://localhost:11434

# MCP server port (default: 8787)
# MCP_PORT=8787

# API server port (default: 8000)
# API_PORT=8000
